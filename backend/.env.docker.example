# Docker Environment Configuration — TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# SETUP: cp .env.docker.example .env.docker  then fill in your real values
# .env.docker is gitignored — your real values never get committed
# ─────────────────────────────────────────────────────────────────────────────

# Application Settings
APP_NAME=Fleet Management System
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Docker internal service name = postgres)
DATABASE_URL=postgresql://fleet_user:your_password_here@postgres:5432/fleet_db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fleet_db
DB_USER=fleet_user
DB_PASSWORD=your_password_here

# JWT Authentication
SECRET_KEY=your-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Questions Encryption
ENCRYPTION_MASTER_KEY=your-encryption-master-key-min-32-chars-change-this

# CORS Configuration
ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password-here
SMTP_FROM_EMAIL=noreply@fleetapp.com
SMTP_FROM_NAME=Fleet Management System

# Frontend URLs
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Observability ─────────────────────────────────────────────────────────────
# OpenTelemetry → SigNoz
# LOCAL DEV (Docker): use host.docker.internal (not localhost — that's the container)
# GCP SERVER:         use localhost (SigNoz runs on same VM) or internal IP
# To enable: flip OTEL_ENABLED=true after SigNoz is running
OTEL_ENABLED=false
OTEL_ENDPOINT=http://host.docker.internal:4317
OTEL_SERVICE_NAME=fleet-management-api

# Prometheus metrics → exposes /metrics endpoint for scraping
PROMETHEUS_ENABLED=false
# ──────────────────────────────────────────────────────────────────────────────

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Security Settings
MAX_FAILED_LOGIN_ATTEMPTS=3
ACCOUNT_LOCKOUT_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
REQUIRED_SECURITY_QUESTIONS_COUNT=3
MAX_RECOVERY_ATTEMPTS=3
RECOVERY_LOCKOUT_MINUTES=30
